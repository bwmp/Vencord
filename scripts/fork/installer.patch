diff --git a/config_windows_test.go b/config_windows_test.go
new file mode 100644
index 0000000..a7f84fa
--- /dev/null
+++ b/config_windows_test.go
@@ -0,0 +1,34 @@
+package main
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+func TestWindowsDefaultConfigPath(t *testing.T) {
+	if os.Getenv("BWMP_TEST_CONFIG_PATH") == "1" {
+		want := filepath.Join(os.Getenv("APPDATA"), "Vencord")
+		if BaseDir != want || !filepath.IsAbs(Patcher) {
+			t.Fatalf("BaseDir = %q, Patcher = %q; want %q with an absolute patcher path", BaseDir, Patcher, want)
+		}
+		if FilesDirErr != nil {
+			t.Fatal(FilesDirErr)
+		}
+		return
+	}
+
+	cmd := exec.Command(os.Args[0], "-test.run=^TestWindowsDefaultConfigPath$")
+	cmd.Env = append(os.Environ(),
+		"BWMP_TEST_CONFIG_PATH=1",
+		"APPDATA="+t.TempDir(),
+		"HOME=",
+		"XDG_CONFIG_HOME=",
+		"VENCORD_USER_DATA_DIR=",
+		"DISCORD_USER_DATA_DIR=",
+	)
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("Default Windows initialization failed: %v\n%s", err, output)
+	}
+}
